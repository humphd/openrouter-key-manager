{
  "name": "openrouter-key-manager",
  "version": "0.16.1",
  "description": "A Node.js Library and CLI tool for managing OpenRouter.ai API keys",
  "type": "module",
  "author": "David Humphrey <david.andrew.humphrey@gmail.com>",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "openrouter-key-manager": "./dist/bin/cli.js"
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc",
    "clean": "rm -fr dist",
    "check": "pnpm prettier-check && pnpm typecheck && pnpm lint && pnpm test",
    "prettier": "prettier . --write",
    "format": "pnpm prettier",
    "prettier-check": "prettier . --check",
    "format-check": "pnpm prettier-check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude src/e2e.test.ts",
    "test:e2e": "pnpm build && vitest run src/e2e.test.ts",
    "test:watch": "vitest"
  },
  "license": "BSD-2-Clause",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@openrouter/sdk": "^1.2.103",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "inquirer": "^14.2.1",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^24.9.2",
    "dotenv": "^17.4.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
